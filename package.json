{
  "name": "pinecone-mcp",
  "version": "1.0.0",
  "description": "MCP server for controlled, tool-based access to Pinecone vector databases",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pinecone-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "watch": "tsc -w",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azizcoban/pinecone-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/azizcoban/pinecone-mcp/issues"
  },
  "homepage": "https://github.com/azizcoban/pinecone-mcp#readme",
  "keywords": [
    "mcp",
    "pinecone",
    "vector-database",
    "ai",
    "agents",
    "model-context-protocol"
  ],
  "author": "Aziz Coban",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@pinecone-database/pinecone": "^5.1.1",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
